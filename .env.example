# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
AXIS_LAN_IP=127.0.0.1
DATABASE_URL=postgresql://axis:axis@localhost:5432/axis_transport
AXIS_ADMIN_USERNAME=admin
AXIS_ADMIN_PASSWORD=replace-with-a-strong-password
AXIS_ADMIN_EMAIL=

# Adresse publique du site (liens de billets, retour après paiement)
PUBLIC_WEB_URL=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Payment Provider ("fedapay" ou "kkiapay")
ACTIVE_PAYMENT_PROVIDER=fedapay

# KKiaPay : non implémenté, désactivé côté serveur (aucune variable utilisée).

# FedaPay
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENVIRONMENT=sandbox
# Écart maximal (secondes) accepté sur l'horodatage signé des webhooks FedaPay
FEDAPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Paiement simulé : pris en compte uniquement si DJANGO_DEBUG=true. Ne jamais activer en production.
AXIS_PAYMENT_SIMULATION=false
