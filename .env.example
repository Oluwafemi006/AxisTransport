# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
AXIS_LAN_IP=127.0.0.1
# Autres sites autorisés à appeler l'API en local (ex. https://axis-transport.vercel.app), séparés par des virgules
AXIS_FRONTEND_ORIGINS=
# Adresses HTTPS acceptées pour les formulaires de /django-admin/ (ex. adresse d'un tunnel)
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://axis:axis@localhost:5432/axis_transport
AXIS_ADMIN_USERNAME=admin
AXIS_ADMIN_PASSWORD=replace-with-a-strong-password
AXIS_ADMIN_EMAIL=

# Adresse publique du site, utilisée dans les liens de billets partagés.
# Laisser vide tant que le nom de domaine n'est pas acheté : aucun lien n'est alors généré.
PUBLIC_WEB_URL=
# Page vers laquelle le prestataire renvoie après un paiement (en local : le site sur le port 3000)
FEDAPAY_CALLBACK_URL=http://localhost:3000/paiement/retour

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Payment Provider ("fedapay" ou "kkiapay")
ACTIVE_PAYMENT_PROVIDER=fedapay

# KKiaPay : non implémenté, désactivé côté serveur (aucune variable utilisée).

# FedaPay
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENVIRONMENT=sandbox
# Écart maximal (secondes) accepté sur l'horodatage signé des webhooks FedaPay
FEDAPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Paiement simulé : pris en compte uniquement si DJANGO_DEBUG=true. Ne jamais activer en production.
AXIS_PAYMENT_SIMULATION=false

# Rattrapage des paiements jamais confirmés (commande « reconcile_payments », à planifier chaque minute)
AXIS_PAYMENT_RECONCILE_ENABLED=true
AXIS_PAYMENT_RECONCILE_WINDOW_MINUTES=1440
AXIS_PAYMENT_RECONCILE_BATCH=20
# Limite de lecture de la page publique d'un billet, par adresse IP
AXIS_PUBLIC_TICKET_RATE=60/min
