# Variables du VPS (compose.vps.yaml). Copier vers .env.vps SUR LE SERVEUR et remplir là-bas.
# .env.vps n'est jamais commité ; les secrets ne se collent ni dans le dépôt ni dans une discussion.
# <IP> = adresse du serveur, <DOMAINE> = nom de domaine une fois acheté. Voir DEPLOY.md, section « VPS ».

# ── Proxy ────────────────────────────────────────────────────────────────────
# Variante A : Caddyfile.http          Variante B : Caddyfile.https
AXIS_CADDYFILE=Caddyfile.http
# Variante A : vide                    Variante B : <DOMAINE> (sans https://, sans www)
AXIS_DOMAIN=

# ── Django ───────────────────────────────────────────────────────────────────
# Secret : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Variante A : <IP>                    Variante B : api.<DOMAINE>
DJANGO_ALLOWED_HOSTS=
# Variante A : http://<IP>             Variante B : https://<DOMAINE>
DJANGO_CORS_ALLOWED_ORIGINS=
# Variante A : http://<IP>             Variante B : https://api.<DOMAINE>
DJANGO_CSRF_TRUSTED_ORIGINS=
# Variante A : http://<IP>             Variante B : https://<DOMAINE>      (vide = aucun lien de billet partagé)
PUBLIC_WEB_URL=
AXIS_NUM_PROXIES=1

# ── Base de données ──────────────────────────────────────────────────────────
# Secret. Lettres et chiffres seulement (il est placé tel quel dans une adresse de connexion).
POSTGRES_PASSWORD=

# ── Site ─────────────────────────────────────────────────────────────────────
# Variante A : http://<IP>/api/v1      Variante B : https://api.<DOMAINE>/api/v1
# Lue au build : après un changement, reconstruire le service « frontend ».
NEXT_PUBLIC_API_URL=

# ── Compte administrateur réel ────────────────────────────────────────────────
# Recommandé : laisser ces trois lignes VIDES et créer le compte sur place avec
#   docker compose --env-file .env.vps -f compose.vps.yaml exec backend python manage.py create_admin
# (mot de passe saisi masqué, jamais écrit dans un fichier). Voir DEPLOY.md, 5.0 étape 5.
AXIS_ADMIN_USERNAME=
AXIS_ADMIN_PASSWORD=
AXIS_ADMIN_EMAIL=

# ── FedaPay ──────────────────────────────────────────────────────────────────
# Variante A : sandbox                 Variante B : sandbox, puis live à l'ouverture réelle
FEDAPAY_ENVIRONMENT=sandbox
# Secrets : clé et secret de webhook du MÊME environnement que FEDAPAY_ENVIRONMENT.
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Variante A : http://<IP>/paiement/retour     Variante B : https://<DOMAINE>/paiement/retour
FEDAPAY_CALLBACK_URL=
FEDAPAY_WEBHOOK_TOLERANCE_SECONDS=300

# ── Réglages facultatifs (valeurs par défaut indiquées) ──────────────────────
AXIS_PARCEL_TRACKING_RATE=20/min
AXIS_PUBLIC_TICKET_RATE=60/min
AXIS_LOGIN_RATE_ACCOUNT_ADDRESS=10/hour
AXIS_LOGIN_RATE_ACCOUNT=50/hour
AXIS_LOGIN_RATE_ADDRESS=30/min
AXIS_REGISTER_RATE_ADDRESS=10/hour
AXIS_PAYMENT_RECONCILE_ENABLED=true
AXIS_PAYMENT_RECONCILE_WINDOW_MINUTES=1440
AXIS_PAYMENT_RECONCILE_BATCH=20
AXIS_PAYMENT_RECONCILE_INTERVAL_SECONDS=60
AXIS_PAYMENT_REFRESH_RATE=20/min

# Photos des colis (Cloudinary) : valeurs saisies uniquement sur le serveur, jamais dans le dépôt.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
