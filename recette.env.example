# Variables du profil de recette (compose.recette.yaml). Copier vers .env.recette et remplir.
# .env.recette n'est jamais commité. Les valeurs ci-dessous sont des exemples, pas des secrets.

# Chaîne aléatoire longue, propre à la recette : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Mot de passe de la base de recette (base séparée de celle de développement)
RECETTE_DB_PASSWORD=

# Noms d'hôte acceptés, sans https:// : localhost pour le site local, plus celui du tunnel
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sites autorisés à appeler l'API : le site local de recette
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3100
# Adresse HTTPS du tunnel, pour les formulaires de /django-admin/ (ex. https://xxxx.exemple.test)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Seul compte créé au démarrage. Mot de passe fort, propre à la recette.
AXIS_ADMIN_USERNAME=
AXIS_ADMIN_PASSWORD=

# FedaPay sandbox. Le secret du webhook est celui de l'adresse déclarée chez FedaPay pour le tunnel.
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_CALLBACK_URL=http://localhost:3100/paiement/retour

# Vide : aucun lien public de billet n'est généré
PUBLIC_WEB_URL=
# Adresse de l'API vue par le navigateur (le site local de recette appelle le backend local)
RECETTE_API_URL=http://localhost:8100/api/v1
